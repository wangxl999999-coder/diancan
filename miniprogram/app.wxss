page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.container {
  padding: 20rpx;
}

.primary-color {
  color: #ff6b35;
}

.bg-primary {
  background-color: #ff6b35;
}

.btn-primary {
  background-color: #ff6b35;
  color: #fff;
  border: none;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
}

.btn-primary::after {
  border: none;
}

.price {
  color: #ff6b35;
  font-weight: bold;
}

.price::before {
  content: '¥';
  font-size: 0.8em;
}

.tag-hot {
  background: #fff0ed;
  color: #f56c6c;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

.tag-recommend {
  background: #fdf6ec;
  color: #e6a23c;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

.tag-limited {
  background: #ecf5ff;
  color: #409eff;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  padding: 20rpx 0;
}

.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.divider {
  height: 1rpx;
  background: #eee;
  margin: 20rpx 0;
}
