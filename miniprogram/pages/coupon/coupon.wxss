.coupon-page { background: #f5f5f5; min-height: 100vh; }
.tabs { display: flex; background: #fff; }
.tab { flex: 1; text-align: center; padding: 25rpx 0; font-size: 28rpx; color: #666; border-bottom: 4rpx solid transparent; }
.tab.active { color: #ff6b35; border-bottom-color: #ff6b35; font-weight: bold; }
.coupon-list { padding: 20rpx; }
.coupon-card { display: flex; background: #fff; border-radius: 16rpx; margin-bottom: 15rpx; overflow: hidden; }
.coupon-left { width: 200rpx; background: linear-gradient(135deg, #ff6b35, #ff8f65); color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 25rpx; }
.coupon-value { font-size: 48rpx; font-weight: bold; }
.coupon-condition { font-size: 22rpx; margin-top: 8rpx; opacity: 0.9; }
.coupon-right { flex: 1; padding: 25rpx; display: flex; flex-direction: column; justify-content: center; }
.coupon-name { font-size: 30rpx; font-weight: bold; }
.coupon-date { font-size: 22rpx; color: #999; margin-top: 10rpx; }
