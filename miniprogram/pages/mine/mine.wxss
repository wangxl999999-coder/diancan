.mine-page { background: #f5f5f5; min-height: 100vh; padding-bottom: calc(env(safe-area-inset-bottom) + 50px); }
.user-header { background: linear-gradient(135deg, #ff6b35, #ff8f65); padding: 60rpx 30rpx 40rpx; display: flex; align-items: center; }
.avatar { width: 120rpx; height: 120rpx; border-radius: 60rpx; border: 4rpx solid rgba(255,255,255,0.5); }
.user-info { margin-left: 25rpx; color: #fff; }
.nickname { font-size: 36rpx; font-weight: bold; display: block; }
.level { font-size: 24rpx; margin-top: 8rpx; opacity: 0.9; display: block; }

.stat-row { display: flex; background: #fff; padding: 30rpx 0; margin-bottom: 15rpx; }
.stat-item { flex: 1; text-align: center; }
.stat-num { display: block; font-size: 34rpx; font-weight: bold; color: #ff6b35; }
.stat-label { display: block; font-size: 24rpx; color: #999; margin-top: 6rpx; }

.menu-list { background: #fff; border-radius: 16rpx; margin: 0 20rpx; overflow: hidden; }
.menu-item { display: flex; align-items: center; padding: 30rpx; border-bottom: 1rpx solid #f5f5f5; }
.menu-icon { font-size: 40rpx; margin-right: 20rpx; }
.menu-text { flex: 1; font-size: 30rpx; }
.menu-arrow { font-size: 32rpx; color: #ccc; }
