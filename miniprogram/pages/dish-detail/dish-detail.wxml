<view class="detail-page" wx:if="{{dish}}">
  <image class="detail-hero" src="{{dish.image}}" mode="aspectFill"></image>

  <view class="detail-info">
    <text class="detail-name">{{dish.name}}</text>
    <view class="detail-tags" wx:if="{{dish.tags.length>0}}">
      <text class="tag-hot" wx:if="{{dish.tags.indexOf('hot_sale')>-1}}">人气热销</text>
      <text class="tag-recommend" wx:if="{{dish.tags.indexOf('recommend')>-1}}">店长推荐</text>
      <text class="tag-limited" wx:if="{{dish.tags.indexOf('limited_price')>-1}}">限时特价</text>
    </view>
    <view class="detail-meta">
      <text class="detail-price price">{{dish.price}}</text>
      <text class="detail-sales">月售{{dish.monthly_sales}}</text>
    </view>
  </view>

  <view class="detail-desc" wx:if="{{dish.description}}">
    <text class="section-label">菜品描述</text>
    <text class="desc-text">{{dish.description}}</text>
  </view>

  <view class="detail-desc" wx:if="{{dish.ingredients}}">
    <text class="section-label">配料</text>
    <text class="desc-text">{{dish.ingredients}}</text>
  </view>

  <view class="detail-desc">
    <text class="section-label">辣度</text>
    <text class="desc-text">{{spicinessMap[dish.spiciness]}}</text>
  </view>

  <view class="spec-section" wx:for="{{dish.specs}}" wx:key="id" wx:for-item="group">
    <text class="section-label">{{group.name}} {{group.is_required?'(必选)':''}}</text>
    <view class="spec-options">
      <view class="spec-option {{selectedSpecs[group.id]&&selectedSpecs[group.id].id===opt.id?'selected':''}}"
            wx:for="{{group.options}}" wx:key="id" wx:for-item="opt"
            data-group="{{group.id}}" data-option="{{opt.id}}" data-name="{{opt.name}}" data-price="{{opt.price}}"
            bindtap="selectSpecOption">
        <text>{{opt.name}}</text>
        <text class="spec-plus" wx:if="{{opt.price>0}}">+¥{{opt.price}}</text>
      </view>
    </view>
  </view>

  <view class="spec-section" wx:if="{{dish.addons.length>0}}">
    <text class="section-label">加料</text>
    <view class="spec-options">
      <view class="spec-option {{isAddonSelected(item.id)?'selected':''}}"
            wx:for="{{dish.addons}}" wx:key="id"
            data-addon="{{item}}" bindtap="toggleAddon">
        <text>{{item.name}}</text>
        <text class="spec-plus">+¥{{item.price}}</text>
      </view>
    </view>
  </view>

  <view class="remark-section">
    <text class="section-label">备注</text>
    <input class="remark-input" placeholder="如：少放盐、不要香菜" value="{{remark}}" bindinput="onRemarkInput" />
  </view>

  <view class="bottom-bar">
    <view class="qty-control">
      <text class="qty-btn" data-type="minus" bindtap="changeQuantity">-</text>
      <text class="qty-num">{{quantity}}</text>
      <text class="qty-btn" data-type="plus" bindtap="changeQuantity">+</text>
    </view>
    <text class="total-label">小计：</text>
    <text class="total-price price">{{totalPrice}}</text>
    <button class="add-cart-btn" bindtap="addToCart">加入购物车</button>
  </view>
</view>
