.points-page { background: #f5f5f5; min-height: 100vh; }
.points-header { background: linear-gradient(135deg, #ff6b35, #ff8f65); padding: 50rpx; text-align: center; color: #fff; }
.points-num { font-size: 70rpx; font-weight: bold; display: block; }
.points-label { font-size: 28rpx; opacity: 0.9; display: block; margin-top: 10rpx; }
.points-list { padding: 20rpx; }
.points-item { display: flex; justify-content: space-between; align-items: center; background: #fff; padding: 25rpx; border-radius: 12rpx; margin-bottom: 10rpx; }
.points-item-left {}
.points-item-remark { font-size: 28rpx; display: block; }
.points-item-time { font-size: 22rpx; color: #999; display: block; margin-top: 6rpx; }
.points-item-val { font-size: 34rpx; font-weight: bold; }
.plus { color: #ff6b35; }
.minus { color: #999; }
