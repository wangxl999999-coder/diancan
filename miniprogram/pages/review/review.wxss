.review-page { padding: 30rpx; background: #f5f5f5; min-height: 100vh; }
.rating-section, .content-section, .image-section { background: #fff; border-radius: 16rpx; padding: 25rpx; margin-bottom: 20rpx; }
.section-label { font-size: 30rpx; font-weight: bold; display: block; margin-bottom: 20rpx; }
.review-textarea { width: 100%; height: 200rpx; border: 1rpx solid #eee; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; }
.image-list { display: flex; flex-wrap: wrap; gap: 15rpx; }
.review-img { width: 160rpx; height: 160rpx; border-radius: 12rpx; }
.add-img { width: 160rpx; height: 160rpx; border: 2rpx dashed #ddd; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; font-size: 60rpx; color: #ccc; }
.submit-btn { margin-top: 30rpx; width: 100%; }
