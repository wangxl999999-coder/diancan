.cart-page { padding-bottom: 120rpx; background: #f5f5f5; min-height: 100vh; }
.order-type-tabs { display: flex; background: #fff; padding: 0; }
.tab { flex: 1; text-align: center; padding: 25rpx 0; font-size: 28rpx; color: #666; border-bottom: 4rpx solid transparent; }
.tab.active { color: #ff6b35; border-bottom-color: #ff6b35; font-weight: bold; }

.table-badge { padding: 15rpx 20rpx; background: #fff; border-bottom: 1rpx solid #eee; }
.table-badge text { background: #ff6b35; color: #fff; font-size: 24rpx; padding: 6rpx 20rpx; border-radius: 20rpx; }

.delivery-form { background: #fff; padding: 20rpx 30rpx; margin-bottom: 15rpx; }
.delivery-form input { height: 70rpx; border-bottom: 1rpx solid #f0f0f0; font-size: 28rpx; }

.cart-items { background: #fff; padding: 20rpx 30rpx; }
.cart-item { display: flex; padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.item-img { width: 140rpx; height: 140rpx; border-radius: 12rpx; flex-shrink: 0; }
.item-info { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; justify-content: space-between; }
.item-name { font-size: 30rpx; font-weight: bold; }
.item-spec { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.item-remark { font-size: 22rpx; color: #e6a23c; margin-top: 4rpx; }
.item-bottom { display: flex; justify-content: space-between; align-items: center; }
.item-price { font-size: 30rpx; }
.qty-control { display: flex; align-items: center; gap: 15rpx; }
.qty-btn { width: 44rpx; height: 44rpx; border-radius: 22rpx; border: 1rpx solid #ddd; display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.qty-num { font-size: 28rpx; min-width: 30rpx; text-align: center; }

.coupon-section { background: #fff; padding: 25rpx 30rpx; margin-top: 15rpx; }
.section-label { font-size: 28rpx; font-weight: bold; margin-bottom: 15rpx; display: block; }
.coupon-item { display: flex; justify-content: space-between; align-items: center; padding: 15rpx 20rpx; border: 2rpx solid #eee; border-radius: 12rpx; margin-bottom: 10rpx; }
.coupon-item.selected { border-color: #ff6b35; background: #fff8f5; }
.coupon-name { font-size: 28rpx; }
.coupon-value { color: #ff6b35; font-size: 28rpx; font-weight: bold; }

.remark-section { background: #fff; padding: 25rpx 30rpx; margin-top: 15rpx; }
.remark-textarea { border: 1rpx solid #eee; border-radius: 12rpx; padding: 20rpx; font-size: 26rpx; width: 100%; height: 150rpx; }

.summary { background: #fff; padding: 25rpx 30rpx; margin-top: 15rpx; }
.summary-row { display: flex; justify-content: space-between; padding: 10rpx 0; font-size: 28rpx; color: #666; }
.summary-row.total { font-size: 34rpx; color: #333; font-weight: bold; border-top: 1rpx solid #eee; padding-top: 20rpx; margin-top: 10rpx; }

.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; height: 110rpx; background: #fff; border-top: 1rpx solid #eee; display: flex; align-items: center; padding: 0 30rpx; }
.pay-info { flex: 1; display: flex; align-items: center; }
.pay-label { font-size: 28rpx; color: #333; }
.pay-amount { font-size: 40rpx; }
.submit-btn { background: #ff6b35; color: #fff; border: none; border-radius: 44rpx; height: 76rpx; line-height: 76rpx; font-size: 28rpx; padding: 0 40rpx; }
.later-btn { background: #fff; color: #ff6b35; border: 2rpx solid #ff6b35; border-radius: 44rpx; height: 76rpx; line-height: 76rpx; font-size: 28rpx; padding: 0 30rpx; margin-left: 15rpx; }
