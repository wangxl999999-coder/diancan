<view class="login-page">
  <view class="logo-area">
    <image class="logo" src="/images/logo.png" mode="aspectFit"></image>
    <text class="app-name">智慧点餐</text>
  </view>

  <view class="wx-login-area">
    <button class="wx-login-btn" open-type="getUserInfo" bindtap="wxLogin">
      <text class="wx-icon">💬</text>
      微信一键登录
    </button>
  </view>

  <view class="divider-area">
    <view class="divider-line"></view>
    <text class="divider-text">或</text>
    <view class="divider-line"></view>
  </view>

  <view class="phone-login-area">
    <view class="input-group">
      <input class="phone-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
      <button class="code-btn" size="mini" bindtap="sendCode" disabled="{{counting}}">{{codeText}}</button>
    </view>
    <input class="code-input" type="number" maxlength="6" placeholder="请输入验证码" value="{{code}}" bindinput="onCodeInput" />
    <button class="phone-login-btn" bindtap="phoneLogin">手机号登录</button>
  </view>
</view>
