.login-page { padding: 60rpx 40rpx; background: #fff; min-height: 100vh; }
.logo-area { text-align: center; margin-bottom: 80rpx; }
.logo { width: 160rpx; height: 160rpx; }
.app-name { display: block; font-size: 40rpx; font-weight: bold; color: #ff6b35; margin-top: 20rpx; }
.wx-login-area { margin-bottom: 40rpx; }
.wx-login-btn { background: #07c160; color: #fff; border-radius: 44rpx; height: 88rpx; line-height: 88rpx; font-size: 32rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.wx-icon { font-size: 40rpx; }
.divider-area { display: flex; align-items: center; margin-bottom: 40rpx; }
.divider-line { flex: 1; height: 1rpx; background: #eee; }
.divider-text { padding: 0 20rpx; color: #999; font-size: 26rpx; }
.phone-login-area {}
.input-group { display: flex; align-items: center; border: 1rpx solid #eee; border-radius: 12rpx; padding: 0 20rpx; margin-bottom: 20rpx; height: 88rpx; }
.phone-input { flex: 1; height: 88rpx; font-size: 28rpx; }
.code-btn { background: #ff6b35; color: #fff; border-radius: 8rpx; font-size: 24rpx; height: 60rpx; line-height: 60rpx; }
.code-input { border: 1rpx solid #eee; border-radius: 12rpx; height: 88rpx; padding: 0 20rpx; font-size: 28rpx; margin-bottom: 30rpx; }
.phone-login-btn { background: #ff6b35; color: #fff; border-radius: 44rpx; height: 88rpx; line-height: 88rpx; font-size: 32rpx; }
